# Raw and derived data are not tracked; see README (Data) for how to re-download the snapshot.
data/raw/**
data/frozen/**
data/interim/**
data/processed/**
!data/**/.gitkeep
!data/manifest.json
!data/release/

# Generated outputs that are reproduced by scripts
results/**/*.parquet
results/**/*.joblib
/logs/**
!/logs/.gitkeep

# Logs
*.log
*.jsonl

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/

# Secrets
.env
.env.*
*.key

# OS
.DS_Store
Thumbs.db
